NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sentry error monitoring
# DSN: create a project at sentry.io → Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
# Environment tag (development | staging | production)
NEXT_PUBLIC_APP_ENV=development
# Source-map upload (CI only — never commit)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Resend transactional email
# 1. Create account at resend.com → API Keys → Add API Key
# 2. Verify your sending domain (e.g. tcas-ai.app) in Resend dashboard
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@tcas-ai.app

# Cron job secret — protect /api/jobs/* endpoints (generate a random string)
CRON_SECRET=
