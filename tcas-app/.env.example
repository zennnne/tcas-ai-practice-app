# =============================================================================
# TCAS AI Practice App — environment variables
# Copy to .env.local and fill in. Never commit real values.
# Full launch checklist (which of these are required + where to get each key):
#   docs/LAUNCH-CHECKLIST.md
# =============================================================================

# --- Supabase (DB + Auth) — REQUIRED --------------------------------------
# Prod: create a project at supabase.com → Settings → API → copy URL + keys.
# Then apply migrations against it (see LAUNCH-CHECKLIST §1).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Public site config — REQUIRED ----------------------------------------
# Prod domain, no trailing slash (used for OG images, sitemap, canonical URLs).
NEXT_PUBLIC_SITE_URL=https://tcas-ai.app
# development | staging | production  (tags Sentry events + gates behavior)
NEXT_PUBLIC_APP_ENV=development

# --- Omise (payment: PromptPay / TrueMoney / card) — REQUIRED for billing --
# Human TODO: create an Omise merchant account (dashboard.omise.co) → Keys.
# Test keys (pkey_test_/skey_test_) first; swap to live keys after Omise's
# 3-phase merchant verification passes. Webhook secret: Omise dashboard →
# Webhooks → endpoint pointing at /api/webhooks/omise.
NEXT_PUBLIC_OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
OMISE_WEBHOOK_SECRET=

# --- Upstash Redis — rate limiting + cost guardrail counter ----------------
# Human TODO: create a free Redis DB at console.upstash.com → copy REST URL + token.
# ⚠️ Without this the cost guardrail (AI spend circuit breaker) is DISABLED —
# it fails open, so wiring this in prod is a hard prerequisite, not optional.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cost guardrail caps (optional — override placeholder defaults) --------
# Daily caps for AI generation spend. Defaults are conservative placeholders,
# NOT a budget analysis — set real numbers once the gen pipeline's per-question
# token cost is known (see src/lib/cost-guardrail/guardrail.ts). No code change
# needed; leaving these blank uses the in-code defaults shown.
COST_GUARDRAIL_AI_CALL_SOFT_CAP=500       # alert past this many gen calls/day
COST_GUARDRAIL_AI_CALL_HARD_CAP=1000      # deny past this many gen calls/day
COST_GUARDRAIL_AI_TOKENS_SOFT_CAP=5000000
COST_GUARDRAIL_AI_TOKENS_HARD_CAP=10000000

# --- Anthropic (Claude) — content generation pipeline ----------------------
# ⚠️ The gen pipeline itself is NOT built yet (separate track). This key is
# needed once it is. Get it at console.anthropic.com → API Keys. See skill
# `claude-api` for model ids + pricing before wiring.
ANTHROPIC_API_KEY=

# --- Sentry — error monitoring ---------------------------------------------
# DSN: create a project at sentry.io → Settings → Client Keys.
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload (CI only — never commit the auth token).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- PostHog — conversion analytics funnel ---------------------------------
# Human TODO: create a project at posthog.com → Project Settings → API key.
# Host is the ingestion endpoint (EU: https://eu.i.posthog.com).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Resend — transactional email (receipt / trial-expiry) -----------------
# 1. Create account at resend.com → API Keys → Add API Key.
# 2. Verify your sending domain (e.g. tcas-ai.app) in the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@tcas-ai.app

# --- Cron jobs — protect /api/jobs/* ---------------------------------------
# Generate a random string (e.g. `openssl rand -hex 32`). The uptime/cron
# caller must send it as a bearer token.
CRON_SECRET=
